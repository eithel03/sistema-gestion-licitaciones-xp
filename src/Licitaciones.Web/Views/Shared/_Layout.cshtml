@{
    var selectedTheme = string.Equals(Context.Request.Cookies["licitaciones.theme"], "dark", StringComparison.OrdinalIgnoreCase) ? "dark" : "light";
    var selectedCurrency = string.Equals(Context.Request.Cookies["licitaciones.currency"], "USD", StringComparison.OrdinalIgnoreCase) ? "USD" : "CRC";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="@selectedTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Licitaciones</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Licitaciones.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg border-bottom app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Licitaciones XP</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegacion">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Licitaciones" asp-action="Index">Licitaciones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Proveedores" asp-action="Index">Proveedores</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Ofertas" asp-action="Index">Ofertas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="NivelesAprobacion" asp-action="Index">Niveles de aprobacion</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="TiposCambio" asp-action="Index">Tipos de cambio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Planificados" asp-action="ApiSwagger">API / Swagger</a></li>
                    </ul>
                    <form class="nav-preference" asp-controller="Preferencias" asp-action="Moneda" method="post">
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <label class="visually-hidden" for="currencyPreference">Moneda</label>
                        <select id="currencyPreference" name="moneda" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="CRC" selected="@(selectedCurrency == "CRC")">CRC</option>
                            <option value="USD" selected="@(selectedCurrency == "USD")">USD</option>
                        </select>
                    </form>
                    <form class="nav-preference" asp-controller="Preferencias" asp-action="Tema" method="post">
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <label class="visually-hidden" for="themePreference">Tema</label>
                        <select id="themePreference" name="tema" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="light" selected="@(selectedTheme == "light")">Claro</option>
                            <option value="dark" selected="@(selectedTheme == "dark")">Oscuro</option>
                        </select>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Sistema de Gestion de Licitaciones
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
