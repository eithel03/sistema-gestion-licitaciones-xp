@model Licitaciones.Web.Models.Aprobaciones.NivelAprobacionIndexViewModel
@{ ViewData["Title"] = "Niveles de aprobacion"; }
<section class="page-header"><div><p class="eyebrow">Parametrizacion</p><h1>Niveles de aprobacion</h1></div><a class="btn btn-primary" asp-action="Create">Crear nivel</a></section>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success">@message</div> }
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Minimo CRC</th><th>Maximo CRC</th><th>Aprobador</th><th class="text-end">Acciones</th></tr></thead><tbody>
@if (Model.Page.Items.Count == 0) { <tr><td colspan="4" class="text-muted">No hay niveles de aprobacion configurados.</td></tr> }
@foreach (var nivel in Model.Page.Items) { <tr><td>@nivel.MontoMinimoCrc.ToString("N2")</td><td>@(nivel.MontoMaximoCrc?.ToString("N2") ?? "Sin limite")</td><td>@nivel.Aprobador</td><td class="text-end action-list"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@nivel.Id">Ver</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@nivel.Id">Editar</a><a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@nivel.Id">Eliminar</a></td></tr> }
</tbody></table></div>
