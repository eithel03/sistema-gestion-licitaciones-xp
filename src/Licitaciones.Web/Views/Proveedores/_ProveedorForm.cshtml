@model Licitaciones.Web.Models.Proveedores.ProveedorFormViewModel

<form method="post" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" autocomplete="organization" data-val-proveedornombre="Use solo letras, numeros, espacios, punto, coma y parentesis." />
        <div class="form-text">Se aceptan letras, numeros, espacios, punto, coma y parentesis.</div>
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
