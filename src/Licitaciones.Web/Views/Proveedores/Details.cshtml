@model Licitaciones.Web.Models.Proveedores.ProveedorDetailsViewModel

@{
    ViewData["Title"] = "Detalle de proveedor";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Proveedores</p>
        <h1>@Model.Proveedor.Nombre</h1>
    </div>
    <div class="action-list">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Proveedor.Id">Editar</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Proveedor.Id">Eliminar</a>
    </div>
</section>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}

<dl class="detail-list">
    <dt>Id</dt>
    <dd>@Model.Proveedor.Id</dd>
    <dt>Nombre normalizado</dt>
    <dd>@Model.Proveedor.NombreNormalizado</dd>
    <dt>Fecha de creacion</dt>
    <dd>@Model.Proveedor.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
    <dt>Ultima actualizacion</dt>
    <dd>@Model.Proveedor.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<section class="mt-4">
    <h2>Ofertas asociadas</h2>
    @if (Model.Ofertas.Count == 0)
    {
        <p class="text-muted">Este proveedor no tiene ofertas registradas.</p>
    }
    else
    {
        <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Licitacion</th><th>Monto CRC</th><th>Registro UTC</th><th></th></tr></thead><tbody>
        @foreach (var oferta in Model.Ofertas)
        {
            <tr><td>@oferta.LicitacionId</td><td>@oferta.MontoOfertadoCrc.ToString("N2")</td><td>@oferta.FechaRegistro.ToString("yyyy-MM-dd HH:mm")</td><td><a asp-controller="Ofertas" asp-action="Details" asp-route-id="@oferta.Id">Ver</a></td></tr>
        }
        </tbody></table></div>
    }
</section>

<a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
