@model Licitaciones.Web.Models.Ofertas.OfertaIndexViewModel
@{ ViewData["Title"] = "Ofertas"; }
<section class="page-header">
    <div><p class="eyebrow">Participacion</p><h1>Ofertas</h1></div>
    <a class="btn btn-primary" asp-action="Create">Crear oferta</a>
</section>
<form method="get" class="toolbar">
    <div><label for="licitacionId" class="form-label">Licitacion</label><select id="licitacionId" name="licitacionId" class="form-select"><option value="">Todas</option>@foreach (var item in Model.Licitaciones) { <option value="@item.Id" selected="@(Model.LicitacionId == item.Id)">@item.Codigo</option> }</select></div>
    <div><label for="proveedorId" class="form-label">Proveedor</label><select id="proveedorId" name="proveedorId" class="form-select"><option value="">Todos</option>@foreach (var item in Model.Proveedores) { <option value="@item.Id" selected="@(Model.ProveedorId == item.Id)">@item.Nombre</option> }</select></div>
    <div><label for="sort" class="form-label">Orden</label><select id="sort" name="sort" class="form-select"><option value="registered">Registro</option><option value="amount">Menor monto</option><option value="amount_desc">Mayor monto</option></select></div>
    <button type="submit" class="btn btn-outline-primary">Filtrar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
</form>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success">@message</div> }
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Licitacion</th><th>Proveedor</th><th>Monto CRC</th><th>Registro UTC</th><th class="text-end">Acciones</th></tr></thead><tbody>
@if (Model.Page.Items.Count == 0) { <tr><td colspan="5" class="text-muted">No hay ofertas registradas con los filtros actuales.</td></tr> }
@foreach (var oferta in Model.Page.Items)
{
    var licitacion = Model.Licitaciones.FirstOrDefault(item => item.Id == oferta.LicitacionId);
    var proveedor = Model.Proveedores.FirstOrDefault(item => item.Id == oferta.ProveedorId);
    <tr><td>@(licitacion?.Codigo ?? oferta.LicitacionId.ToString())</td><td>@(proveedor?.Nombre ?? oferta.ProveedorId.ToString())</td><td>@oferta.MontoOfertadoCrc.ToString("N2")</td><td>@oferta.FechaRegistro.ToString("yyyy-MM-dd HH:mm")</td><td class="text-end action-list"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@oferta.Id">Ver</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@oferta.Id">Editar</a><a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@oferta.Id">Eliminar</a></td></tr>
}
</tbody></table></div>
<nav class="pagination-row"><span>Pagina @Model.Page.Page de @(Model.Page.TotalPages == 0 ? 1 : Model.Page.TotalPages) - @Model.Page.TotalItems registros</span></nav>
