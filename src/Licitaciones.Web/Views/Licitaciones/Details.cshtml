@model Licitaciones.Application.Licitaciones.LicitacionResponse

@{
    ViewData["Title"] = "Detalle de licitacion";

    var esBorrador = Model.Estado.ToString() == "Borrador";
    var esPublicada = Model.Estado.ToString() == "Publicada";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Licitaciones</p>
        <h1>@Model.Codigo</h1>
    </div>

    @if (esBorrador)
    {
        <div class="action-list">
            <a class="btn btn-outline-primary"
               asp-action="Edit"
               asp-route-id="@Model.Id">
                Editar
            </a>
        </div>
    }
</section>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<dl class="detail-list">
    <dt>Titulo</dt>
    <dd>@Model.Titulo</dd>

    <dt>Presupuesto CRC</dt>
    <dd><partial name="_MoneyDisplay" model="@Model.PresupuestoCrc" /></dd>

    <dt>Fecha de cierre UTC</dt>
    <dd>@Model.FechaCierreUtc.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt>Estado</dt>
    <dd>@Model.Estado</dd>

    <dt>Estado efectivo</dt>
    <dd>@Model.EstadoEfectivo</dd>

    <dt>Version</dt>
    <dd>@Model.Version</dd>
</dl>

<div class="action-list">

    @if (esBorrador)
    {
        <form asp-action="Publish"
              asp-route-id="@Model.Id"
              method="post">
            @Html.AntiForgeryToken()

            <button class="btn btn-outline-success"
                    type="submit">
                Publicar
            </button>
        </form>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">
            @Html.AntiForgeryToken()

            <button class="btn btn-outline-danger"
                    type="submit">
                Retirar
            </button>
        </form>
    }

    @if (esPublicada)
    {
        <form asp-action="Close"
              asp-route-id="@Model.Id"
              method="post">
            @Html.AntiForgeryToken()

            <button class="btn btn-outline-warning"
                    type="submit">
                Cerrar
            </button>
        </form>
    }

</div>

<a class="btn btn-outline-secondary mt-3"
   asp-action="Index">
    Volver al listado
</a>
