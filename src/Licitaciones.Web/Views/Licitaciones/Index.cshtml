@model Licitaciones.Web.Models.Licitaciones.LicitacionIndexViewModel
@{
    ViewData["Title"] = "Licitaciones";
}
<section class="page-header"><div><p class="eyebrow">Gestion</p><h1>Licitaciones</h1></div><a class="btn btn-primary" asp-action="Create">Crear licitacion</a></section>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success" role="alert">@message</div> }
<form method="get" class="toolbar">
    <div class="search-box"><label for="search" class="form-label">Buscar</label><input id="search" name="search" value="@Model.Search" class="form-control" /></div>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <button class="btn btn-outline-primary" type="submit">Buscar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
</form>
<table class="table table-hover align-middle"><thead><tr><th>Codigo</th><th>Titulo</th><th>Presupuesto CRC</th><th>Cierre</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-muted">No hay licitaciones registradas.</td></tr> }
else { foreach (var item in Model.Items) { <tr><td>@item.Codigo</td><td>@item.Titulo</td><td><partial name="_MoneyDisplay" model="@item.PresupuestoCrc" /></td><td>@item.FechaCierreUtc.ToString("yyyy-MM-dd HH:mm") UTC</td><td>@item.EstadoEfectivo</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Ver</a></td></tr> } }
</tbody></table>
<nav class="pagination-row"><span>Pagina @Model.Page de @(Model.TotalPages == 0 ? 1 : Model.TotalPages) - @Model.TotalItems registros</span><div class="btn-group"><a class="btn btn-outline-secondary @(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search">Anterior</a><a class="btn btn-outline-secondary @(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search">Siguiente</a></div></nav>
