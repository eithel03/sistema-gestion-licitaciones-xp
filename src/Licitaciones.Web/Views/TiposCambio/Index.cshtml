@model Licitaciones.Web.Models.TiposCambio.TipoCambioIndexViewModel
@{ ViewData["Title"] = "Tipos de cambio"; }
<section class="page-header"><div><p class="eyebrow">Moneda</p><h1>Tipos de cambio</h1></div><a class="btn btn-primary" asp-action="Create">Crear tipo de cambio</a></section>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success" role="alert">@message</div> }
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Fecha</th><th>CRC por USD</th><th>Activo</th><th class="text-end">Acciones</th></tr></thead><tbody>
@if (Model.Page.Items.Count == 0) { <tr><td colspan="4" class="text-muted">No hay tipos de cambio registrados.</td></tr> }
@foreach (var item in Model.Page.Items)
{
    <tr><td>@item.Fecha.ToString("yyyy-MM-dd")</td><td>@item.CrcPorUsd.ToString("N2")</td><td>@(item.Activo ? "Si" : "No")</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Ver</a></td></tr>
}
</tbody></table></div>
