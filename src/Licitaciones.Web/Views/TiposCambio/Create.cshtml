@model Licitaciones.Web.Models.TiposCambio.TipoCambioFormViewModel
@{ ViewData["Title"] = "Crear tipo de cambio"; }
<section class="page-header"><div><p class="eyebrow">Moneda</p><h1>Crear tipo de cambio</h1></div></section>
<form asp-action="Create" method="post" class="form-panel">
    @Html.AntiForgeryToken()
    <partial name="_TipoCambioForm" model="Model" />
    <div class="form-actions"><button class="btn btn-primary" type="submit">Guardar</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
